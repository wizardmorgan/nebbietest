[Unit]
Description=NebbieDash identify DB sync hub
After=network.target

[Service]
Type=simple
User=nebbie
WorkingDirectory=/opt/nebbie-ident-sync
Environment=NEBBIE_IDENT_TOKEN=CHANGE_ME
Environment=NEBBIE_IDENT_DATA=/var/lib/nebbie-ident-sync/ident-db.json
Environment=NEBBIE_IDENT_HOST=127.0.0.1
Environment=NEBBIE_IDENT_PORT=8787
ExecStart=/usr/bin/python3 /opt/nebbie-ident-sync/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
