# Config locale per scripts/mud-dev.sh
# Copia in: ~/.config/nebbie/mud-dev.env

# --- Percorsi nucbuntu (consigliato) ---
MUD_ROOT="${HOME}/NebbieArcane/Server"
EDIT_REPO="${HOME}/NebbieArcane/Server"          # C++ / myst (edit_portal.cpp)
MUD_APP_ROOT="${HOME}/NebbieArcane/Server"
PORTAL_UI_ROOT="${HOME}/NebbieArcane/edit-portal" # UI ufficiale (Node)

# --- Remotes mud (clone Server) ---
# upstream → NebbieArcane/Server (Montero, feature/Principi)
# mine     → wizardmorgan/nebbietest (C++ portal, finché non è su Server ufficiale)
PRINCIPI_REMOTE=upstream
PRINCIPI_BRANCH=feature/Principi
EDIT_REMOTE=mine
EDIT_BRANCH=feature/edit-portal
UPSTREAM_REMOTE=upstream

# --- UI ufficiale NebbieArcane/edit-portal (SSH deploy key) ---
PORTAL_UI_REMOTE=origin
PORTAL_UI_BRANCH=develop
PORTAL_UI_GIT_URL=git@github.com:NebbieArcane/edit-portal.git
PORTAL_UI_SSH_KEY="${HOME}/.ssh/edit_portal_deploy"

# Porte
# EDIT_WEB_PORT=3080
# EDIT_API_PORT=8090
# EDIT_API_SECRET=nebbie-edit-dev-secret

# Procedura Principi: docs/sync-principi-procedure.md (nel clone Server)
# Setup UI SSH: docs/edit-portal-ssh-deploy.md (nel clone edit-portal)
