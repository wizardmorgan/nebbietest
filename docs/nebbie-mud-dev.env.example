# Config locale per scripts/mud-dev.sh
# Una sola directory (consigliato su nucbuntu):
MUD_ROOT="${HOME}/NebbieArcane/Server"
EDIT_REPO="${HOME}/NebbieArcane/Server"
MUD_APP_ROOT="${HOME}/NebbieArcane/Server"

# Remotes tipici sul clone nucbuntu (non c'è origin):
#   upstream → NebbieArcane/Server (Montero, feature/Razze)
#   mine     → wizardmorgan/nebbietest (feature/edit-portal)
RAZZE_REMOTE=upstream
RAZZE_BRANCH=feature/Razze
EDIT_REMOTE=mine
EDIT_BRANCH=feature/edit-portal

# Se usi ancora un secondo clone solo per test fork, imposta EDIT_REPO/MUD_APP_ROOT di conseguenza.
# Procedura riallineamento Montero: docs/sync-razze-procedure.md
