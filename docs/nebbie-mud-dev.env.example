# Config locale per scripts/mud-dev.sh (non nel repo NebbieArcane).
# Installazione: mkdir -p ~/.config/nebbie && cp docs/nebbie-mud-dev.env.example ~/.config/nebbie/mud-dev.env
#
# MUD_ROOT     = clone upstream (git pull origin feature/Razze)
# EDIT_REPO    = clone fork con edit-portal (feature/edit-portal)
# MUD_APP_ROOT = sorgente myst nel container (/app): EDIT_REPO se testi edit-portal, MUD_ROOT per solo Razze

MUD_ROOT="${HOME}/NebbieArcane/Server"
EDIT_REPO="${HOME}/docker-vms/Server"
MUD_APP_ROOT="${EDIT_REPO}"
