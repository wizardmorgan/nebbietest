# Copia come .env nella root del repo (docker compose)

LOCAL_UID=1000
LOCAL_GID=1000
DOCKER_PLATFORM=linux/amd64
SERVER_PORT=4003
EDIT_API_PORT=8090
EDIT_API_SECRET=nebbie-edit-dev-secret
EDIT_SESSION_SECRET=nebbie-edit-session-dev
EDIT_WEB_PORT=3080
EDIT_STAFF_LEVEL=57
EDIT_LIMITED_LEVEL=51

